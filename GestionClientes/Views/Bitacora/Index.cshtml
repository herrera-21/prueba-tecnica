@model List<GestionClientes.Models.Bitacora>
@{
    ViewBag.Title = "Bitacora";
}

<h4 class="mb-3">Bitacora de cambios</h4>

<form method="get" action="@Url.Action("Index")" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Filtrar por ID de cliente, usuario o accion" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha y hora</th>
                    <th>Accion</th>
                    <th>Cliente</th>
                    <th>Usuario</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay movimientos registrados.</td>
                    </tr>
                }

                @foreach (var movimiento in Model)
                {
                    string clase = movimiento.Accion == "AGREGAR" ? "text-bg-success"
                                 : movimiento.Accion == "EDITAR" ? "text-bg-primary"
                                 : "text-bg-danger";

                    <tr>
                        <td class="text-nowrap">@movimiento.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td><span class="badge @clase">@movimiento.Accion</span></td>
                        <td>#@movimiento.ClienteId</td>
                        <td>@movimiento.NombreUsuario</td>
                        <td>@movimiento.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small mt-2 mb-0">Se muestran los ultimos 200 movimientos.</p>
