@model List<GestionClientes.Models.Cliente>
@{
    ViewBag.Title = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Clientes</h4>
    <a class="btn btn-primary" href="@Url.Action("Crear")">Nuevo cliente</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" action="@Url.Action("Index")" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por nombre, apellido o documento" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Documento</th>
                    <th>Correo</th>
                    <th>Telefono</th>
                    <th>Direccion</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay clientes registrados.</td>
                    </tr>
                }

                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Nombres</td>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.Documento</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Direccion</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar", new { id = cliente.Id })">Editar</a>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                    data-id="@cliente.Id"
                                    data-nombre="@cliente.Nombres @cliente.Apellidos">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="tituloEliminar" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloEliminar">Eliminar cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Seguro que desea eliminar a <strong id="nombreCliente"></strong>?</p>
                <p class="text-muted small mb-0">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                @using (Html.BeginForm("Eliminar", "Clientes", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="idCliente" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // abre el modal con el nombre del cliente que se va a eliminar
        var modalEliminar = new bootstrap.Modal(document.getElementById("modalEliminar"));

        document.querySelectorAll(".btn-eliminar").forEach(function (boton) {
            boton.addEventListener("click", function () {
                document.getElementById("idCliente").value = boton.getAttribute("data-id");
                document.getElementById("nombreCliente").textContent = boton.getAttribute("data-nombre");
                modalEliminar.show();
            });
        });
    </script>
}
